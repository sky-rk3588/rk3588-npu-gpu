From 650c4375d737bac575c50189057de10a78fa3f43 Mon Sep 17 00:00:00 2001
From: Igor Paunovic <royalnet026@gmail.com>
Date: Sat, 1 Aug 2026 14:55:03 +0200
Subject: [PATCH] arm64: dts: rockchip: rk3588: add passive cooling to the NPU
 thermal zone

The NPU thermal zone only declares a critical trip at 115 degC, so
between normal operation and an emergency shutdown there is nothing at
all: no passive trip, no cooling map, and polling-delay-passive is 0.
The GPU zone, defined a few lines above from the same tsadc, has both a
passive trip at 85 degC and a cooling map onto the GPU.

That asymmetry was harmless while the NPU ran at the fixed
assigned-clock-rate of 200 MHz, since it could not be slowed down
anyway.  Once the NPU gains DVFS it can be throttled like any other
devfreq device, and the missing passive trip becomes the difference
between backing off and hitting the critical trip.

Mirror the GPU zone: add a passive trip at the same 85 degC with 2 degC
of hysteresis, enable passive polling, and map the trip onto the first
NPU core.  The three cores share the NPU clock and supply, so DVFS is
driven from the first one and that is where a cooling device is
registered; the other two follow it.

Signed-off-by: Igor Paunovic <royalnet026@gmail.com>
---
 arch/arm64/boot/dts/rockchip/rk3588-base.dtsi | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi b/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
index 4b247fc84..b9d58c814 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
@@ -1162,6 +1162,7 @@ rknn_core_0: npu@fdab0000 {
 		clock-names = "aclk", "hclk", "npu", "pclk";
 		assigned-clocks = <&scmi_clk SCMI_CLK_NPU>;
 		assigned-clock-rates = <200000000>;
+		#cooling-cells = <2>;
 		resets = <&cru SRST_A_RKNN0>, <&cru SRST_H_RKNN0>;
 		reset-names = "srst_a", "srst_h";
 		power-domains = <&power RK3588_PD_NPUTOP>;
@@ -3312,17 +3313,31 @@ map0 {
 		};
 
 		npu_thermal: npu-thermal {
-			polling-delay-passive = <0>;
+			polling-delay-passive = <100>;
 			polling-delay = <0>;
 			thermal-sensors = <&tsadc 6>;
 
 			trips {
+				npu_alert: npu-alert {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
 				npu_crit: npu-crit {
 					temperature = <115000>;
 					hysteresis = <0>;
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&npu_alert>;
+					cooling-device =
+						<&rknn_core_0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 	};
 
